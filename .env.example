# ==========================================
# 前端环境变量（VITE_ 前缀 → 暴露给浏览器端）
# ==========================================
VITE_API_BASE=/api
VITE_API_PROXY_TARGET=http://localhost:8788

# ==========================================
# 后端环境变量（Cloudflare Functions 用）
# 开发时请将实际值填入 .dev.vars
# 生产环境通过 Cloudflare Dashboard Secrets 或 wrangler secret 设置
# ==========================================
# API_KEY=your_api_key_here
# BASE_URL=https://open.bigmodel.cn/api/paas/v4
# MODEL=glm-4-flash
