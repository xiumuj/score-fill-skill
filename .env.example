# ==========================================
# 前端环境变量（VITE_ 前缀 → 暴露给浏览器端）
# ==========================================
VITE_API_BASE=/api
VITE_API_PROXY_TARGET=http://localhost:8788

# ==========================================
# 后端环境变量（Cloudflare Functions 用）
# LLM 使用平台内置 SDK，无需配置
# 语音识别需配置豆包（火山引擎）凭证
# ==========================================
# DOUBAO_APP_ID=your_app_id
# DOUBAO_ACCESS_KEY_ID=your_access_key_id
# DOUBAO_ACCESS_KEY_SECRET=your_access_key_secret
